# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
DATABASE_URL=sqlite:///data/app.db
AS_OF_DATE=2026-11-15              # fixed demo "today" (ASM A-02)
LLM_PROVIDER=template              # gemini | anthropic | openai | ollama | template | fake_adversarial
LLM_MODEL_ID=                      # set per provider; verify current model name
LLM_FALLBACK_PROVIDER=template
LLM_TIMEOUT_S=20
LLM_MAX_RPM=10
LLM_DEBUG_LOG=false                # true writes full prompts to logs/llm_debug/ (dev only, git-ignored)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
BACKEND_URL=http://localhost:8000
OUTBOX_DIR=outbox
